APP_ENV=development
APP_NAME=polymarket-tail-risk
LOG_LEVEL=INFO
LOG_JSON=false
RULE_VERSION=dev

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=sqlite:///./var/data/ptr_dev.sqlite3

NEXT_PUBLIC_APP_NAME=Polymarket Tail Risk
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

CELERY_BROKER_URL=sqla+sqlite:///./var/celery/broker.sqlite3
CELERY_RESULT_BACKEND=db+sqlite:///./var/celery/results.sqlite3
CELERY_BEAT_SCHEDULE_DB=./var/celery/celerybeat-schedule

POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
INGEST_HTTP_TIMEOUT_SECONDS=15
INGEST_GAMMA_PAGE_SIZE=100
INGEST_CLOB_BATCH_SIZE=100
INGEST_MARKET_SYNC_INTERVAL_SECONDS=900
INGEST_SNAPSHOT_INTERVAL_SECONDS=60
INGEST_SNAPSHOT_TARGET_SIZE=100
INGEST_SNAPSHOT_MARKET_LIMIT=200

DQ_RULE_VERSION=dq_v1
DQ_RUN_INTERVAL_SECONDS=120
DQ_MARKET_LIMIT=200
DQ_SNAPSHOT_STALE_AFTER_SECONDS=300
DQ_SOURCE_STALE_AFTER_SECONDS=86400
DQ_MAX_MID_PRICE_JUMP_ABS=0.35
DQ_WARNING_SPREAD_THRESHOLD=0.25
DQ_SNAPSHOT_FUTURE_TOLERANCE_SECONDS=15

TAGGING_RUN_INTERVAL_SECONDS=0
TAGGING_MARKET_LIMIT=200

TRADING_LIVE_MODE_ENABLED=false
TRADING_DEFAULT_ORDER_SIZE=10
TRADING_LIVE_BANKROLL_FRACTION=0.02
TRADING_LIVE_MIN_NOTIONAL=5
TRADING_LIVE_MAX_NOTIONAL=25
TRADING_LIVE_DAILY_ORDER_LIMIT=3
TRADING_LIVE_STATUS_POLL_ATTEMPTS=5
TRADING_LIVE_STATUS_POLL_INTERVAL_SECONDS=2
TRADING_LIVE_PRIVATE_KEY=
TRADING_LIVE_CHAIN_ID=137
TRADING_LIVE_SIGNATURE_TYPE=0
TRADING_LIVE_FUNDER_ADDRESS=
TRADING_LIVE_API_KEY=
TRADING_LIVE_API_SECRET=
TRADING_LIVE_API_PASSPHRASE=
TRADING_LIVE_USE_SERVER_TIME=true
TRADING_LIVE_RETRY_ON_ERROR=true

SCORING_RUN_INTERVAL_SECONDS=180
SCORING_MARKET_LIMIT=200

REVIEW_TASK_GENERATION_INTERVAL_SECONDS=300
REVIEW_TASK_MARKET_LIMIT=200

TAG_QUALITY_RUN_INTERVAL_SECONDS=21600
MONITORING_METRICS_INTERVAL_SECONDS=300
REPORTS_GENERATION_INTERVAL_SECONDS=604800
